# Shared environment for OS-Ken controller containers (osken + osken_2)
# Used by: source/sdn_controller/topology.py, main_n1.py, main_n2.py
#
# Per-container overrides (set via -e in build_network_setup.sh, not here):
#   NETWORK_ID, TOPOLOGY_PUB_PORT, PEER_TOPOLOGY_ENDPOINTS

# Telemetry aggregator subscription endpoints
AGGREGATOR_ENDPOINTS=tcp://10.0.0.5:5556,tcp://10.0.1.5:5556

# Topology publish/heartbeat tuning
TOPOLOGY_INTERVAL=1
TOPOLOGY_HEARTBEAT_TICKS=30

# VIP_SERVER — per-LAN client-facing HTTP VIP.
# LAN1 clients use VIP_SERVER (10.0.0.253); LAN2 clients use VIP_SERVER_N2 (10.0.1.253).
VIP_SERVER_IP=10.0.0.253
VIP_SERVER_MAC=aa:bb:cc:dd:ee:01

VIP_SERVER_N2_IP=10.0.1.253
VIP_SERVER_N2_MAC=aa:bb:cc:dd:ee:04

# Per-domain VIP_DATA — each domain has its own VIP address.
# When a server connects to VIP_DATA_N1 it is routed to LAN1's storage;
# connecting to VIP_DATA_N2 routes to LAN2's storage.
VIP_DATA_N1_IP=10.0.0.254
VIP_DATA_N1_MAC=aa:bb:cc:dd:ee:02
VIP_DATA_N2_IP=10.0.1.254
VIP_DATA_N2_MAC=aa:bb:cc:dd:ee:03
VIP_DATA_RECOVERY_N1_IP=10.0.0.252
VIP_DATA_RECOVERY_N1_MAC=aa:bb:cc:dd:ee:12
VIP_DATA_RECOVERY_N2_IP=10.0.1.252
VIP_DATA_RECOVERY_N2_MAC=aa:bb:cc:dd:ee:13

# Cross-network routing: OVS port number connected to the inter-LAN router.
# The router is the 3rd port added to each bridge (veth3 on ovs-br0, veth23 on ovs-br1).
ROUTER_OVS_PORT=3

# MAC of the router's interface on this controller's LAN.
# Overridden per-controller via -e in build_network_setup.sh.
ROUTER_MAC=

# MAC sets — comma-separated; empty means none registered at startup
SERVER_MACS=
STORAGE_MACS_N1=00:00:00:00:00:04
STORAGE_MACS_N2=00:00:00:00:00:06

# VIP routing — per-dimension WSM weights and DNAT/SNAT flow timeouts
# Server (compute) cost function weights
W_CPU=0.3
W_RAM=0.1
W_REQUESTS=0.2
W_HOPS=0.28
# Storage cost function weights
W_STORAGE_CPU=0.2
W_STORAGE_RAM=0.1
W_STORAGE_CONNECTIONS=0.2
W_STORAGE_LAG=0.2
W_STORAGE_HOPS=0.3
VIP_IDLE_TIMEOUT=30
VIP_HARD_TIMEOUT=120
VIP_DATA_RECOVERY_IDLE_TIMEOUT=40
VIP_DATA_RECOVERY_HARD_TIMEOUT=45
VIP_DATA_RECOVERY_SESSION_MAX_AGE_S=35

# Cross-network routing: OVS port number connecting to the inter-LAN router.
# 0 = disabled (local-only).  Both LANs use port 3 (veth3 / veth23).
ROUTER_OVS_PORT=3
# Constant hop penalty for backends on the peer network (WSM cost formula)
CROSS_NETWORK_HOP_PENALTY=3

# ── Elasticity: scale-up ─────────────────────────────────────────────

# Score weights
SCALEUP_W_STORAGE_CPU=0.60
SCALEUP_W_T_DB=0.40
SCALEUP_W_CPU=0.40
SCALEUP_W_T_PROC=0.60

# Normalisation floors/spans (calibrated for container-level CPU readings;
# latency floors/spans match observed healthy edge behaviour)
SCALEUP_STORAGE_CPU_FLOOR=1.5
SCALEUP_STORAGE_CPU_SPAN=5
SCALEUP_T_DB_FLOOR=60
SCALEUP_T_DB_SPAN=250
SCALEUP_CPU_FLOOR=4.5
SCALEUP_CPU_SPAN=5
SCALEUP_T_PROC_FLOOR=20
SCALEUP_T_PROC_SPAN=50

# Adaptive compute scale-up
SCALEUP_REQUIRED=3
SCALEUP_COMPUTE_BASE_THRESHOLD=0.25
SCALEUP_COMPUTE_THRESHOLD_INCREMENT=0.10
SCALEUP_COMPUTE_MAX_THRESHOLD=0.85
SCALEUP_COMPUTE_COOLDOWN_S=45
SCALEUP_COMPUTE_PEER_RELIEF=0.03
SCALEUP_COMPUTE_PEER_HEALTH_THRESHOLD=0.35

# Adaptive storage scale-up
SCALEUP_STORAGE_BASE_THRESHOLD=0.20
SCALEUP_STORAGE_THRESHOLD_INCREMENT=0.10
SCALEUP_STORAGE_MIN_INCREMENT=0.05
SCALEUP_STORAGE_MAX_THRESHOLD=0.55
SCALEUP_STORAGE_WINDOW_SIZE=5
SCALEUP_STORAGE_REQUIRED=2

# ── Storage persistent reserve ───────────────────────────────────────
STORAGE_PERSISTENT_RESERVE_ENABLED=1

# Hard caps (per LAN)
# Current ablation setting: storage-reserve validation — Tier 1 and compute disabled.
# Update these knobs in place before each rerun configuration.
MAX_DYNAMIC_STORAGE=5
MAX_DYNAMIC_COMPUTE=0

# ── Elasticity: scale-down ───────────────────────────────────────────

# Per-tier cooldown after scale-up (suppress premature scale-down)
# These values are set with consideration for the integrated experiment's workload phases and durations.
SCALEDOWN_STORAGE_COOLDOWN_S=120
SCALEDOWN_COMPUTE_COOLDOWN_S=180

# Scale-down sliding window
SCALE_DOWN_STORAGE_WINDOW_SIZE=15
SCALE_DOWN_STORAGE_REQUIRED=9

# Birth grace
NODE_BIRTH_GRACE_S=60

# Path to network scripts inside the container (used by elasticity manager)
NODE_SCRIPTS_DIR=/workspace/scripts/network

# ── Selective sync (Tier 1) ──────────────────────────────────────────
# Current ablation setting: C4 selective-sync plus storage and compute elasticity.
# Update SS_ENABLED / MAX_DYNAMIC_STORAGE / MAX_DYNAMIC_COMPUTE in this file
# in place before each rerun configuration.
# TAU_DADOS_MS and SS_MIN_READS_PER_WINDOW use the code defaults tuned for the
# standard `phases.json` workload (see scaling_config.py and edge_server/source/app.py).
SS_ENABLED=0

# Coordinator-state ZMQ PUB port (per-container override via -e in
# build_network_setup.sh, mirrors TOPOLOGY_PUB_PORT). Used by
# collect_resource_stats.py to ingest Tier1OwnerState snapshots into
# resource_stats.csv. Defaults to 0 (disabled).
COORDINATOR_STATE_PUB_PORT=0
