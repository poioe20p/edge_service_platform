# Sourced by scripts/build_network_setup.sh and consumed by
# scripts/network/inject_wan_latency.sh (called from build_router.sh).
# RTT presets (ms): lab 0, metro 10 (default), regional 40, inter-continental 150.
# The 10 ms metro default is calibrated so that peer-LAN database time stays
# above TAU_DADOS_MS, which is what lets the storage-pressure signal fire,
# while the total request time moves only a few milliseconds.

# Symmetric RTT between LAN1 and LAN2, in ms; half is applied on each of the router's egress
# queues (eth1 LAN1, eth2 LAN2), so the observed RTT is WAN_RTT_MS.
WAN_RTT_MS=${WAN_RTT_MS:-10}

# Optional jitter on top of one-way delay (ms). 0 = deterministic delay.
WAN_JITTER_MS=0

# Optional packet loss percentage (0–100). 0 = lossless.
WAN_LOSS_PCT=0

# Optional egress bandwidth cap in kbit. 0 = uncapped.
WAN_RATE_KBIT=0
