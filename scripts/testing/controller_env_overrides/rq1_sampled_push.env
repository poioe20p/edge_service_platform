# RQ1 delivery-semantics campaign — Arm D: sampled-push (fresh + lossy).
# Regime: in-order sub-second delivery of every SAMPLE_EVERY-th window;
# intermediate windows dropped (analyzer computes misses from the universe).
# Completes the RQ1 completeness x info-age 2x2: A fresh+complete, B stale+
# complete, C stale+lossy, D fresh+lossy.
# Rebased from rq1_event_preserving.env (same platform block); ONLY the
# delivery-specific vars differ. Consumed via OSKEN_ENV_OVERRIDE_FILE.
# NOTE: like Arm C's POLL_INTERVAL_S, SAMPLE_EVERY is read by the controller
# from its environment; there is no build_network_setup.sh -e override for it,
# so the env file value is authoritative (verify in controller_env_snapshot.env).
LATENCY_SIGNAL_MODE=mean
TELEMETRY_SOURCE=sampled_push
SAMPLE_EVERY=3
EVENT_POLL_INTERVAL_S=0.5
CONTROL_TICK_S=10
DELIVERY_LOG_PATH=/tmp/telemetry_delivery_log.csv
DECISION_LOG_PATH=/tmp/decision_log.csv

# Thesis §2: persistent reserves disabled
STORAGE_PERSISTENT_RESERVE_ENABLED=0

# --- Platform block rebased from current_state_integrated.env (2026-08-01) ---
MAX_DYNAMIC_STORAGE=3
MAX_DYNAMIC_COMPUTE=3
SCALEUP_STORAGE_BASE_THRESHOLD=0.35
SCALEUP_COMPUTE_BASE_THRESHOLD=0.18
SCALEUP_CPU_FLOOR=10
SCALEUP_CPU_SPAN=40
SCALEUP_T_PROC_FLOOR=25
SCALEUP_W_CPU=0.60
SCALEUP_W_T_PROC=0.40
SCALEDOWN_COMPUTE_COOLDOWN_S=180
# RQ1 scale-down calibration (2026-08-02): compute 3-of-6 with relaxed below
# criterion (TAU_CPU_DOWN=25 / TAU_PROC_DOWN_MS=40); identical across arms.
SCALE_DOWN_COMPUTE_WINDOW_SIZE=6
SCALE_DOWN_COMPUTE_REQUIRED=3
TAU_CPU_DOWN=25
TAU_PROC_DOWN_MS=40
SCALEDOWN_STORAGE_COOLDOWN_S=30
SCALE_DOWN_STORAGE_WINDOW_SIZE=5
SCALE_DOWN_STORAGE_REQUIRED=3
SCALEUP_W_STORAGE_CPU=0
SCALEUP_W_T_DB=1.0
SCALEUP_STORAGE_CPU_FLOOR=1.5
SCALEUP_STORAGE_CPU_SPAN=5
# RQ1 uses the mean signal (LATENCY_SIGNAL_MODE=mean) — mean-scale thresholds.
SCALEUP_T_DB_FLOOR=60
SCALEUP_T_DB_SPAN=250
SCALEUP_STORAGE_REQUIRED=2
SCALEUP_STORAGE_WINDOW_SIZE=5
SCALEUP_STORAGE_COOLDOWN_S=120
VIP_HARD_TIMEOUT=60
# 2026-08-07 RQ1 post-campaign fix: raise the VIP_DATA forward-flow idle
# timeout from 10s so a connection waiting on a queued edge is not dropped
# mid-request (http=000 "unknown" population root cause — see
# rq1_v3_platform_fix_plan.md §3.4). hard_timeout unaffected.
VIP_DATA_IDLE_TIMEOUT=600
# 2026-08-04 G2 retune (open-loop collapse root-cause): RQ1 envs were rebased
# from current_state_integrated.env before the 2026-08-03 data-path fix, so
# edge servers ran with EDGE_MONGO_MAX_POOL_SIZE=1 (serialized DB) -> DB-latency
# explosion + 256m OOM at open-loop 120 req/s/LAN. Same platform block RQ2/
# control use; RQ1 now runs on the fixed pooled data path.
# 2026-08-05 G2 sweep: pool 12 (rate 2.0/1.5 + churn guard) STILL collapsed
# (p50 16-17s) — 4 edges x 12 = 48 concurrent Mongo ops thrash the storage tier
# at STORAGE_CPUS=0.08. Reverted to pool 6 (6 conns/edge = RQ2's proven config:
# ba_db_cal4 at rate 1.5 completes 87% / p50 2s). Rate 1.5 + pool 6 + churn
# guard = the RQ2-comparable bounded-overload test (rq1_g2_rate15_p6).
EDGE_MONGO_READ_PREFERENCE=secondaryPreferred
VIP_DATA_PER_CONNECTION_FLOWS=1
EDGE_MONGO_MAX_POOL_SIZE=6
