# RQ3 notification with a confirmation check — the app_ready event wakes an
# immediate probe and the backend is admitted only when that probe succeeds.
# With the message dropped, the 20 s event-absence fallback admits on its own
# probe instead. Merge this over rq3sat_direct.env; it is the arm that
# distinguishes the fourth admission mode of the RQ3 campaign.
READINESS_WAKE_VERIFY_MODE=probe
READINESS_EVENT_FALLBACK_S=20
